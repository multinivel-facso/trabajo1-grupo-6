```{r descriptivos n1}

data %>%  select (ess, ess_f, edu_univ,inghogar_i, inghogar_i_mil) %>% sjmisc::descr(.,
                                                                                                     show = c("label","range", "mean", "sd", "NA.prc", "n"))%>%
